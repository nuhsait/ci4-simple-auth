{
    "name": "nuhsait/ci4-simple-auth",
    "description": "Lightweight HTTP Basic Auth library for closed CodeIgniter 4 systems with admin-managed users and an interactive setup command",
    "type": "library",
    "keywords": [
        "codeigniter",
        "codeigniter4",
        "auth",
        "authentication",
        "basic-auth"
    ],
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Nuhsait\\Ci4SimpleAuth\\": "src/"
        },
        "files": [
            "src/Helpers/auth_helper.php"
        ]
    },
    "authors": [
        {
            "name": "Nuh Sait ULAŞ",
            "email": "me@nuhsait.com"
        }
    ]
}
